        "min": 1,
        "max": 100
      },
      "adjustments": [
        "exposure",
        "levels",
        "contrast",
        "sharpness",
        "noiseReduction",
        "whiteBalance"
      ],
      "batch": true,
      "faceProtection": "Require manual review and confirmed masks for every photo; fail closed when a photo is unreviewed or verification fails."
