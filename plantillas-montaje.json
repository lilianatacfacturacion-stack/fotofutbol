  "constraints": {
    "generativeAI": true,
    "sourcePhotosOnly": true,
    "preserveUploadedPixels": true,
    "faceProtection": "Never apply tonal edits to pixels inside manually confirmed human or animal face masks.",
    "backgroundRemoval": "Cutout layers use on-device MediaPipe human segmentation or a user-supplied transparent PNG. Segmentation is approximate and intended only as a first cut; require visual review before export. Never claim success if the segmentation failed.",
    "generativeAIUsage": "Solo se usa en fondos artísticos preparados; los píxeles del jugador no se generan, amplían ni estilizan."
  },
  "independentTools": [
    {
      "id": "photo-levels",
      "label": "Editar · mejorar niveles",
      "purpose": "Traditional photographic adjustments for one image or a batch, independent of montage templates.",
